{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Fable",
      "destination": "/fable",
      "permanent": true
    },
    {
      "source": "/FABLE",
      "destination": "/fable",
      "permanent": true
    },
    {
      "source": "/Guias",
      "destination": "/guias",
      "permanent": true
    },
    {
      "source": "/GTA",
      "destination": "/gta",
      "permanent": true
    },
    {
      "source": "/Gta",
      "destination": "/gta",
      "permanent": true
    }
  ]
}